# Copy to .env and adjust. Never commit .env.

# PostgreSQL
POSTGRES_HOST=localhost
# 5433 on the host so it never clashes with a Postgres already installed on your machine
POSTGRES_PORT=5433
POSTGRES_DB=payment_router
POSTGRES_USER=router
POSTGRES_PASSWORD=change_me

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Routing weights (see docs/architecture.md)
LAMBDA_COST=0.15
LAMBDA_LATENCY=0.10

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me

# Circuit breaker
CB_FAILURE_RATE_THRESHOLD=0.5
CB_WINDOW_SECONDS=300

# Router (Stages 7-9)
ROUTER_SOURCE=db          # db or csv
ROUTER_HEALTH=auto        # auto, redis or memory
EVENT_BUS=auto            # auto, kafka or none
REDIS_PREFIX=router:
BREAKER_COOLDOWN_S=30
